#on init
#    start vendor.keymint-qti

service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    class early_hal
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/odm/lib64:/odm/variant/annibale/odm/lib64:/odm/variant/dada/odm/lib64:/odm/variant/haotian/odm/lib64:/odm/variant/pudding/odm/lib64:/odm/variant/pandora/odm/lib64:/odm/variant/popsicle/odm/lib64:/odm/variant/nezha/odm/lib64:/system/lib64:/sbin
    seclabel u:r:recovery:s0
